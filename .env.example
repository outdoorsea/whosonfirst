# Who's On First API Environment Configuration
# Copy this file to .env and update with your values

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wof
DB_USER=user
DB_PASS=password

# Connection Pool Settings
DB_MIN_CONNECTIONS=1
DB_MAX_CONNECTIONS=10

# For local development with docker-compose, use:
# DB_HOST=localhost

# For production AWS deployment, use:
# DB_HOST=wof-postgis-db.xxxxxxxxx.us-east-1.rds.amazonaws.com
# Get this from: cd terraform && terraform output db_endpoint
